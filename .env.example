# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_PAYSTACK_PUBLIC_KEY: Your Paystack PUBLIC key (starts with pk_).
# Safe to expose to the browser — it can only initiate a charge, never move
# money without the corresponding SECRET key. Get it from
# https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# PAYSTACK_SECRET_KEY is NOT set here. It must never reach the browser bundle.
# It is only ever configured as a Cloud Functions secret:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
# See functions/index.js.
